Set-Content -Path .gitignore -Value @"
# 가상환경 및 캐시
__pycache__/
*.py[cod]
.venv/
env/
venv/
.env

# 대용량 데이터 및 압축파일 전면 무시 (100MB 초과 파일)
*.zip
*.tar.gz
data/한국_금융데이터.csv
한국_금융데이터.csv
data/processed/cleaned.csv
data/processed/eligible_universe.csv
data/processed/buy_signals.csv

# 보고서 및 분석용 경량 요약본은 허용 (Allowlist)
!data/processed/sector_performance.csv
!data/processed/daily_sector_returns.csv
!data/processed/intraday_price_analysis.csv
!data/processed/anomaly_flt_events.csv
!data/processed/anomaly_name_mismatch.csv
!data/processed/summary.json
!data/processed/charts/*.png
!data/processed/*.txt
"@ -Encoding utf8